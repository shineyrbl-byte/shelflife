# Copy to .env.local. Everything is optional for local use.

# Free key from https://aistudio.google.com/apikey: turns on "Scan a bill" and "Write with AI"
GEMINI_API_KEY=

# Hosted database (Turso). Leave empty to use the local file in data/.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Public URL of the app, used for links in the daily summary (defaults to the request's address)
APP_URL=

# Long random string. Lets `npm run summary` (or a scheduled job) fetch a shop's summary without logging in.
CRON_SECRET=
# Optional: push the daily summary to your phone via https://ntfy.sh (free, no account).
# Pick a long, hard-to-guess topic name: anyone who knows it can read the messages.
NTFY_TOPIC=
# Optional: a self-hosted ntfy server instead of https://ntfy.sh
NTFY_URL=

# Optional: email for "Forgot password" via Brevo (free, 300/day). EMAIL_FROM must be a sender
# you've verified in Brevo (Senders, Domains & Dedicated IPs → Senders).
BREVO_API_KEY=
EMAIL_FROM=
