# Shop name shown on the customer deals page and in WhatsApp messages
NEXT_PUBLIC_SHOP_NAME="Café Mogra"

# Optional: free key from https://aistudio.google.com/apikey turns on "Write with AI" for bundle names
GEMINI_API_KEY=

# Optional: push the daily summary to your phone via https://ntfy.sh (free, no account).
# Pick a long, hard-to-guess topic name: anyone who knows it can read the messages.
NTFY_TOPIC=
# Public URL of the app, used for links in the summary (defaults to the request origin)
APP_URL=
